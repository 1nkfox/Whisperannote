<VerificationPlan VERSION="0.2.0">
  <GlobalPolicy>
    <log-format>[Module][function][BLOCK_NAME] message</log-format>
    <deterministic-first>true</deterministic-first>
    <module-level-focus>Быстрые детерминированные проверки рядом с модулем (alignment, форматтеры, auth, валидация путей).</module-level-focus>
    <wave-level-focus>Слитые поверхности: pipeline на коротком реальном WAV.</wave-level-focus>
    <phase-level-focus>Интеграция и регресс: запуск backend, очередь, e2e ручной транскрибации.</phase-level-focus>
    <autonomy-gate>Каждый shared-модуль до автономного исполнения должен иметь команды, сценарии, наблюдаемые доказательства и wave/phase follow-up.</autonomy-gate>
    <redaction>Никогда не логировать HF-токен и секрет-токен backend.</redaction>
    <ml-policy>Тяжёлые модели подменяются фейками на module-level; реальные pyannote/faster-whisper — только на wave/phase с малым сэмплом. Сеть в тестах запрещена.</ml-policy>
  </GlobalPolicy>

  <CriticalFlows>
    <VF-TRANSCRIBE NAME="РучнаяТранскрибацияHappyPath" USE_CASES="UC-001,UC-002" DATA_FLOW="DF-TRANSCRIBE" PRIORITY="high">
      <scenario>Пользователь загружает короткий русский WAV, получает сегменты со спикерами и таймстемпами.</scenario>
      <expected-outcome>Результат содержит непустые сегменты; у каждого speaker, start, end, text, confidence; WS присылает complete.</expected-outcome>
      <required-signals>
        <log-marker>[Pipeline][run][BLOCK_RUN_PIPELINE]</log-marker>
        <trace-sequence>BLOCK_EXTRACT_WAV -> BLOCK_RUN_PIPELINE(diarize) -> BLOCK_ITER_SEGMENTS -> align -> format -> complete</trace-sequence>
      </required-signals>
    </VF-TRANSCRIBE>

    <VF-LONGFILE NAME="ДлинныйФайлБезЧанкинга" USE_CASES="UC-001" DATA_FLOW="DF-TRANSCRIBE" PRIORITY="high">
      <scenario>Файл длительностью 60+ минут обрабатывается одним нативным проходом faster-whisper.</scenario>
      <expected-outcome>Нет ffmpeg-нарезки на 300-сек чанки; на границах нет обрывов слов/дублей; память стабильна.</expected-outcome>
      <required-signals>
        <log-marker>[Transcribe][transcribe][BLOCK_ITER_SEGMENTS]</log-marker>
        <trace-assertion>Не должно быть вызовов извлечения под-WAV по чанкам.</trace-assertion>
      </required-signals>
    </VF-LONGFILE>

    <VF-SECURITY NAME="БезопасностьBackend" USE_CASES="UC-010" DATA_FLOW="DF-TRANSCRIBE" PRIORITY="high">
      <scenario>Запрос без секрет-токена или с file_path вне разрешённых папок.</scenario>
      <expected-outcome>Запрос без токена -> 401; file_path вне allowed_roots -> 400; CORS отклоняет посторонний origin.</expected-outcome>
      <required-signals>
        <log-marker>[Auth][require_token][BLOCK_VERIFY_TOKEN]</log-marker>
        <trace-assertion>Путь вне allowed_roots не доходит до M-PIPELINE.</trace-assertion>
      </required-signals>
    </VF-SECURITY>

    <VF-WATCH-NOLOOP NAME="АвтообработкаБезПетли" USE_CASES="UC-005" DATA_FLOW="DF-WATCH" PRIORITY="high">
      <scenario>Один новый файл появляется в watchFolder; приложение его обрабатывает.</scenario>
      <expected-outcome>Файл обработан ровно один раз; результаты и промежуточные файлы не ставятся в очередь повторно.</expected-outcome>
      <required-signals>
        <log-marker>[Watcher][onAdd][BLOCK_STABILIZE_FILE]</log-marker>
        <trace-assertion>В watchFolder не появляется промежуточный MP3/WAV.</trace-assertion>
      </required-signals>
    </VF-WATCH-NOLOOP>

    <VF-CANCEL NAME="КооперативнаяОтмена" USE_CASES="UC-008" DATA_FLOW="DF-TRANSCRIBE" PRIORITY="medium">
      <scenario>Пользователь отменяет активную транскрибацию.</scenario>
      <expected-outcome>Цикл по сегментам прерывается на ближайшей границе; temp-файлы удаляются; статус cancelled.</expected-outcome>
      <required-signals>
        <log-marker>[Transcribe][transcribe][BLOCK_ITER_SEGMENTS]</log-marker>
        <trace-assertion>После отмены не выполняется format и не остаётся temp-файлов.</trace-assertion>
      </required-signals>
    </VF-CANCEL>

    <VF-GPU-SERIAL NAME="ОдинGpuJob" USE_CASES="UC-005" DATA_FLOW="DF-WATCH" PRIORITY="high">
      <scenario>В очередь поступает несколько файлов одновременно.</scenario>
      <expected-outcome>В любой момент processing in {0,1}; задачи не выполняются параллельно на GPU.</expected-outcome>
      <required-signals>
        <log-marker>[Queue][processNext][BLOCK_PROCESS_NEXT]</log-marker>
        <trace-assertion>Нет перекрытия двух BLOCK_RUN_PIPELINE по времени.</trace-assertion>
      </required-signals>
    </VF-GPU-SERIAL>

    <VF-ONBOARD-NOCUDA NAME="ОнбордингБезCuda" USE_CASES="UC-007" DATA_FLOW="DF-ONBOARD" PRIORITY="high">
      <scenario>На машине нет доступного CUDA-GPU.</scenario>
      <expected-outcome>health status=error с понятным сообщением; обработка не стартует; CPU не используется.</expected-outcome>
      <required-signals>
        <log-marker>[Server][lifespan][BLOCK_LIFESPAN_INIT]</log-marker>
      </required-signals>
    </VF-ONBOARD-NOCUDA>
  </CriticalFlows>

