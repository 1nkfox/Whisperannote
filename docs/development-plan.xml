        <purpose>Pydantic-модели запросов/ответов и доменных сущностей (TranscriptSegment, TranscriptionResult, TaskInfo, WSMessage, HealthStatus).</purpose>
        <inputs><param name="dict" type="JSON" /></inputs>
        <outputs><param name="model" type="BaseModel" /></outputs>
      </contract>
      <interface>
        <export-TranscriptSegment PURPOSE="speaker, start, end, text, confidence" />
        <export-TranscriptionResult PURPOSE="Итог транскрибации + speaker_names + output_files" />
        <export-TaskInfo PURPOSE="Статус задачи в очереди" />
      </interface>
      <depends>none</depends>
      <target><source>backend/models.py</source><tests>backend/tests/test_models.py</tests></target>
      <verification-ref>V-M-SCHEMAS</verification-ref>
      <notes><note-1>Адаптировано из WhisperLiveKit timed_objects.py; токен-уровень не нужен.</note-1></notes>
    </M-SCHEMAS>

